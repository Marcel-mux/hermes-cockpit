# Hermes Cockpit - Environment Configuration
# Copy this file to .env and adjust as needed.

# Cockpit HTTP Server
PORT=8088
HOST=0.0.0.0

# Hermes Agent Backend Target
# Host & port of your Hermes Agent gateway (dashboard service)
HERMES_HOST=127.0.0.1
HERMES_PORT=9119

# Default Profile Name for Cockpit sessions
# Using a dedicated profile (e.g. hermes-cockpit) isolates mobile chat history
# from your primary CLI/Telegram/WhatsApp sessions.
HERMES_PROFILE=hermes-cockpit

# Hermes Home Directory (where state.db and profiles reside)
# Default: ~/.hermes
# HERMES_HOME=/home/user/.hermes

# 9Router Home Directory (optional, for live telemetry & quota monitoring)
# Default: ~/.9router
# NINEROUTER_HOME=/home/user/.9router
